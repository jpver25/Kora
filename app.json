{
  "expo": {
    "name": "Kora",
    "slug": "Kora",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kora",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "cl.kora.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Kora usa la cámara para escanear códigos de barras y reconocer productos.",
        "NSPhotoLibraryUsageDescription": "Kora puede usar fotos para identificar productos."
      }
    },
    "android": {
      "package": "cl.kora.app",
      "adaptiveIcon": {
        "backgroundColor": "#163B35",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": ["CAMERA", "android.permission.CAMERA"],
      "edgeToEdgeEnabled": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FAF8F4"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Kora usa la cámara para escanear códigos de barras y reconocer productos.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Kora usa tus fotos para aportes comunitarios de empaques.",
          "cameraPermission": "Kora usa la cámara para aportes comunitarios de empaques."
        }
      ],
      "expo-apple-authentication",
      "expo-dev-client"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "replace-with-eas-project-id"
      }
    }
  }
}
