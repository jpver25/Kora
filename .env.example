# Copy to `.env` and fill values. Restart Metro after changes (`npx expo start -c`).

# --- Supabase (catalog + pgvector) ---
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# --- Visual AI (Phase 3) ---
# Preferred for Expo Go: deploy supabase/functions/visual-identify and set Supabase keys above
# (function reads OPENAI_API_KEY from Supabase secrets — not from the client).
#
# Dev-only alternative (avoid shipping this key in production builds):
# EXPO_PUBLIC_OPENAI_API_KEY=sk-...
# EXPO_PUBLIC_OPENAI_VISION_MODEL=gpt-4o-mini
#
# Optional override if the function is hosted elsewhere:
# EXPO_PUBLIC_KORA_VISION_URL=https://YOUR_PROJECT.supabase.co/functions/v1/visual-identify
